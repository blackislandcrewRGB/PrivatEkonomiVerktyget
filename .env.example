# Copy to .env (never committed). Everything here is optional: the tool runs without a .env.

# The port the server listens on, and the database file (relative to the project root).
API_PORT=3001
DATABASE_PATH=data/finance.db

# The address the server listens on. 127.0.0.1 (the default) reaches only this computer.
# HOST=127.0.0.1

# The names, besides localhost, a request may be addressed to (DNS-rebinding protection).
# PUBLIC_BASE_URL is the address you open the tool on from other devices (behind a VPN);
# ALLOWED_HOSTS is a comma-separated list of further names.
# PUBLIC_BASE_URL=https://ekonomi.example.net
# ALLOWED_HOSTS=

# Enable Banking: fetch transactions straight from the bank (docs/DRIFT.md). The key goes in
# secrets/ (never in git). EB_REDIRECT_URL must be registered with the Enable Banking application.
# EB_APP_ID=
# EB_PRIVATE_KEY_PATH=secrets/<application id>.pem
# EB_REDIRECT_URL=https://ekonomi.example.net/api/enable-banking/callback

# ntfy: a topic (or a whole address) for the weekly digest and warnings. Anyone who knows the
# topic can read it, so make it hard to guess. Nothing is sent without it.
# NTFY_TOPIC=

# Uptime Kuma: the push address of a push monitor. It holds Kuma's token: a secret.
# KUMA_PUSH_URL=
