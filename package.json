{
  "name": "privatekonomi",
  "version": "0.1.0",
  "description": "Ett verktyg för hushållets ekonomi i Sverige: importera från bankens filer, kategorisera, följ fasta utgifter, dela utgifter och se sparandet. Lokalt, utan inloggning.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:test": "PRIVATEKONOMI_INSTANCE=test npm run dev",
    "start": "npm run build:web && SERVE_WEB=1 tsx server/src/index.ts",
    "start:server": "SERVE_WEB=1 tsx server/src/index.ts",
    "dev:server": "tsx watch --clear-screen=false server/src/index.ts",
    "dev:web": "npm run icons:brands && vite --config web/vite.config.ts",
    "build:web": "npm run icons:brands && vite build --config web/vite.config.ts && tsx scripts/precompress.ts dist/web",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/src/db/cli.ts migrate",
    "db:seed": "tsx server/src/db/cli.ts seed",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons:brands": "tsx scripts/gen-brand-icons.ts",
    "deploy": "bash scripts/deploy.sh",
    "deploy:rollback": "bash scripts/deploy.sh --rollback",
    "db:pull": "bash scripts/db-pull.sh",
    "db:check": "tsx scripts/db-check.ts",
    "check:personuppgifter": "bash scripts/personuppgifter.sh",
    "db:demo": "tsx scripts/demo.ts",
    "demo": "tsx scripts/demo.ts && PRIVATEKONOMI_INSTANCE=test DATABASE_PATH=data/demo/finance-demo.db npm run dev"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@tanstack/react-virtual": "^3.14.13",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^18.0.0",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.8",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "node-cron": "^4.6.0",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "read-excel-file": "^9.3.10",
    "recharts": "^3.10.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "simple-icons": "^16.31.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
